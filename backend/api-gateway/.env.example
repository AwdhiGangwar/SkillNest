# Environment variables for API Gateway
# Copy this to .env and update with actual values

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILE=dev

# Service URLs (Docker/Production)
USER_SERVICE_URL=http://user-service:8081
COURSE_SERVICE_URL=http://course-service:8082
ENROLLMENT_SERVICE_URL=http://enrollment-service:8083
CLASS_SERVICE_URL=http://class-service:8084
ADMIN_SERVICE_URL=http://admin-service:8086
PAYMENT_SERVICE_URL=http://payment-service:8085
TEACHER_REQUEST_SERVICE_URL=http://user-service:8081

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skillnest.vercel.app

# Logging
LOG_LEVEL=INFO
GATEWAY_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
APP_LOG_LEVEL=INFO
LOG_FILE_PATH=logs/api-gateway.log

# JVM Settings
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC
